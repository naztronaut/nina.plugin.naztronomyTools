<ResourceDictionary
    x:Class="Naztronomy.NINA.Tools.Options"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DataTemplate x:Key="Naztronomy Tools_Options">
        <StackPanel Orientation="Vertical" Margin="0,10,0,0">
            <TabControl MinHeight="300">

                <TabItem Header="Discord">
                    <StackPanel Orientation="Vertical" Margin="10">

                        <TextBlock
                            Margin="0,0,0,5"
                            FontWeight="Bold"
                            Text="Discord Custom Image Message" />

                        <TextBlock
                            Margin="0,0,0,10"
                            TextWrapping="Wrap"
                            Text="The 'Discord - Custom Image Message' sequence trigger posts these values to Discord on its interval. Set the webhook URL on the Config tab. A Dropbox share link is converted to a direct image link automatically." />

                        <TextBlock Margin="0,10,0,2" Text="Image URL or file path" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBox
                                MinWidth="400"
                                VerticalAlignment="Center"
                                ToolTip="An http(s) image URL (e.g. a Dropbox link) or a local file path (e.g. C:\allsky\latest.jpg). Local files are uploaded directly to Discord."
                                Text="{Binding DiscordImageUrl, UpdateSourceTrigger=LostFocus}" />
                            <Button
                                Margin="6,0,0,0"
                                Padding="10,3"
                                VerticalAlignment="Center"
                                Content="Browse…"
                                Command="{Binding BrowseImageFileCommand}" />
                        </StackPanel>

                        <CheckBox
                            Margin="0,8,0,0"
                            HorizontalAlignment="Left"
                            Content="Bypass image cache (append timestamp)"
                            ToolTip="Makes Discord fetch a fresh image each time instead of serving a cached copy. For URLs this adds a changing parameter; for local files it uses a unique filename. Enable for frequently-updated images such as all-sky cameras."
                            IsChecked="{Binding DiscordBypassImageCache}" />

                        <TextBlock Margin="0,10,0,2" Text="Message" />
                        <TextBox
                            MinWidth="400"
                            MinHeight="60"
                            HorizontalAlignment="Left"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto"
                            Text="{Binding DiscordMessage, UpdateSourceTrigger=LostFocus}" />

                        <TextBlock
                            Margin="0,20,0,5"
                            FontWeight="Bold"
                            Text="Embed (optional)" />

                        <TextBlock Margin="0,5,0,2" Text="Bot Name" />
                        <TextBox
                            MinWidth="400"
                            HorizontalAlignment="Left"
                            ToolTip="Overrides the name the webhook posts under. Leave blank to use the webhook default."
                            Text="{Binding DiscordUsername, UpdateSourceTrigger=LostFocus}" />

                        <TextBlock Margin="0,10,0,2" Text="Title" />
                        <TextBox
                            MinWidth="400"
                            HorizontalAlignment="Left"
                            Text="{Binding DiscordEmbedTitle, UpdateSourceTrigger=LostFocus}" />

                        <TextBlock Margin="0,10,0,2" Text="Footer" />
                        <TextBox
                            MinWidth="400"
                            HorizontalAlignment="Left"
                            Text="{Binding DiscordEmbedFooter, UpdateSourceTrigger=LostFocus}" />

                        <TextBlock Margin="0,10,0,2" Text="Color (#RRGGBB)" />
                        <TextBox
                            MinWidth="120"
                            HorizontalAlignment="Left"
                            ToolTip="Accent color of the embed's left edge, e.g. #2E86DE."
                            Text="{Binding DiscordEmbedColor, UpdateSourceTrigger=LostFocus}" />

                        <Button
                            Margin="0,15,0,0"
                            Padding="10,3"
                            HorizontalAlignment="Left"
                            Content="Send test message"
                            Command="{Binding SendTestDiscordMessageCommand}" />

                    </StackPanel>
                </TabItem>

                <TabItem Header="Target Scheduler">
                    <StackPanel Orientation="Vertical" Margin="10">

                        <TextBlock
                            Margin="0,0,0,5"
                            FontWeight="Bold"
                            Text="Scheduler Preview" />

                        <TextBlock
                            Margin="0,0,0,10"
                            TextWrapping="Wrap"
                            Text="The 'Discord - Scheduler Preview' instruction reads the plan preview from the Target Scheduler plugin's HTTP API. You must enable the API in Target Scheduler's settings (it is off by default). The message is posted using the webhook configured on the Config tab." />

                        <TextBlock Margin="0,5,0,2" Text="API host" />
                        <TextBox
                            MinWidth="200"
                            HorizontalAlignment="Left"
                            ToolTip="Usually localhost when NINA and Target Scheduler run on the same machine."
                            Text="{Binding TargetSchedulerApiHost, UpdateSourceTrigger=LostFocus}" />

                        <TextBlock Margin="0,10,0,2" Text="API port" />
                        <TextBox
                            MinWidth="120"
                            HorizontalAlignment="Left"
                            ToolTip="Must match the API port set in Target Scheduler (default 8188)."
                            Text="{Binding TargetSchedulerApiPort, UpdateSourceTrigger=LostFocus}" />

                    </StackPanel>
                </TabItem>

                <TabItem Header="Logs">
                    <StackPanel Orientation="Vertical" Margin="10">

                        <TextBlock
                            Margin="0,0,0,5"
                            FontWeight="Bold"
                            Text="Log Monitor" />

                        <TextBlock
                            Margin="0,0,0,10"
                            TextWrapping="Wrap"
                            Text="Monitors NINA's latest log file and posts a Discord alert when it sees the items selected below. It runs on its own (no sequence required) and stays on across NINA restarts while the switch below is on. Set the webhook URL on the Config tab." />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <CheckBox
                                VerticalAlignment="Center"
                                IsChecked="{Binding LogMonitorEnabled}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Margin="10,0,0,0"
                                FontWeight="Bold"
                                Text="Log monitor enabled" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <CheckBox
                                VerticalAlignment="Center"
                                IsChecked="{Binding LogMonitorNotifyOnErrors}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Margin="10,0,0,0"
                                Text="Notify on errors (ERROR and FATAL)" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <CheckBox
                                VerticalAlignment="Center"
                                ToolTip="Warnings can be frequent. Enable only if you want to be alerted to every warning."
                                IsChecked="{Binding LogMonitorNotifyOnWarnings}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Margin="10,0,0,0"
                                Text="Notify on warnings (WARNING)" />
                        </StackPanel>

                        <TextBlock
                            Margin="0,15,0,2"
                            Text="Always notify on lines containing (one phrase per line)" />
                        <TextBox
                            MinWidth="400"
                            MinHeight="80"
                            HorizontalAlignment="Left"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto"
                            ToolTip="Case-insensitive. Any log line (of any level) containing one of these phrases raises an alert, e.g. 'filter wheel' or 'timed out'. Leave blank to rely only on the level checkboxes above."
                            Text="{Binding LogMonitorKeywords, UpdateSourceTrigger=LostFocus}" />

                        <TextBlock
                            Margin="0,20,0,5"
                            FontWeight="Bold"
                            Text="Discord message" />

                        <TextBlock Margin="0,5,0,2" Text="Bot Name" />
                        <TextBox
                            MinWidth="400"
                            HorizontalAlignment="Left"
                            ToolTip="Overrides the name the webhook posts under for log alerts. Leave blank to use the webhook default."
                            Text="{Binding LogMonitorUsername, UpdateSourceTrigger=LostFocus}" />

                        <TextBlock Margin="0,10,0,2" Text="Title" />
                        <TextBox
                            MinWidth="400"
                            HorizontalAlignment="Left"
                            ToolTip="The embed title for log alerts. Leave blank to use a default that reflects the severity."
                            Text="{Binding LogMonitorEmbedTitle, UpdateSourceTrigger=LostFocus}" />

                    </StackPanel>
                </TabItem>

                <TabItem Header="Config">
                    <StackPanel Orientation="Vertical" Margin="10">

                        <TextBlock
                            Margin="0,0,0,5"
                            FontWeight="Bold"
                            Text="Notifications" />

                        <TextBlock
                            Margin="0,0,0,10"
                            TextWrapping="Wrap"
                            Text="These settings are shared by every Naztronomy Tools notification feature. The Discord webhook URL configured here is used by the Discord, Target Scheduler, and Log Monitor tools. It is encrypted at rest." />

                        <TextBlock Margin="0,5,0,2" Text="Discord Webhook URL" />
                        <TextBox
                            MinWidth="400"
                            HorizontalAlignment="Left"
                            Text="{Binding DiscordWebhookUrl, UpdateSourceTrigger=LostFocus}" />

                    </StackPanel>
                </TabItem>

            </TabControl>
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
