<ResourceDictionary
    x:Class="Naztronomy.NINA.Tools.Options"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DataTemplate x:Key="Naztronomy Tools_Options">
        <StackPanel Orientation="Vertical" Margin="0,10,0,0">
            <TabControl MinHeight="300">

                <TabItem Header="Discord">
                    <StackPanel Orientation="Vertical" Margin="10">

                        <TextBlock
                            Margin="0,0,0,5"
                            FontWeight="Bold"
                            Text="Discord Custom Image Message" />

                        <TextBlock
                            Margin="0,0,0,10"
                            TextWrapping="Wrap"
                            Text="These values are used as the defaults for new 'Discord - Custom Image Message' triggers. A Dropbox share link will be converted to a direct image link automatically." />

                        <TextBlock Margin="0,5,0,2" Text="Discord Webhook URL" />
                        <TextBox
                            MinWidth="400"
                            HorizontalAlignment="Left"
                            Text="{Binding DiscordWebhookUrl, UpdateSourceTrigger=LostFocus}" />

                        <TextBlock Margin="0,10,0,2" Text="Image URL (e.g. Dropbox link)" />
                        <TextBox
                            MinWidth="400"
                            HorizontalAlignment="Left"
                            Text="{Binding DiscordImageUrl, UpdateSourceTrigger=LostFocus}" />

                        <TextBlock Margin="0,10,0,2" Text="Message" />
                        <TextBox
                            MinWidth="400"
                            MinHeight="60"
                            HorizontalAlignment="Left"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto"
                            Text="{Binding DiscordMessage, UpdateSourceTrigger=LostFocus}" />

                        <Button
                            Margin="0,15,0,0"
                            Padding="10,3"
                            HorizontalAlignment="Left"
                            Content="Send test message"
                            Command="{Binding SendTestDiscordMessageCommand}" />

                    </StackPanel>
                </TabItem>

            </TabControl>
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
