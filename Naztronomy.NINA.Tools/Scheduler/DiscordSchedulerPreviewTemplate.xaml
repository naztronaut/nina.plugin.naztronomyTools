<ResourceDictionary
    x:Class="Naztronomy.NINA.Tools.Scheduler.DiscordSchedulerPreviewTemplate"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Naztronomy.NINA.Tools.Scheduler"
    xmlns:mini="clr-namespace:NINA.View.Sequencer.MiniSequencer;assembly=NINA.Sequencer"
    xmlns:nina="clr-namespace:NINA.View.Sequencer;assembly=NINA.Sequencer">

    <DataTemplate DataType="{x:Type local:DiscordSchedulerPreviewInstruction}">
        <nina:SequenceBlockView>
            <nina:SequenceBlockView.SequenceItemContent>
                <TextBlock
                    VerticalAlignment="Center"
                    FontStyle="Italic"
                    Text="Posts the Target Scheduler preview to Discord" />
            </nina:SequenceBlockView.SequenceItemContent>
        </nina:SequenceBlockView>
    </DataTemplate>

    <DataTemplate x:Key="Naztronomy.NINA.Tools.Scheduler.DiscordSchedulerPreviewInstruction_Mini">
        <mini:MiniSequenceItem>
            <TextBlock VerticalAlignment="Center" Text="Discord - Scheduler Preview" />
        </mini:MiniSequenceItem>
    </DataTemplate>

</ResourceDictionary>
